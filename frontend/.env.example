# Optional. Defaults to /api, proxied to the FastAPI server by Vite in dev.
# VITE_API_URL=http://localhost:8000/api

# Optional. The realtime chat/notification socket; defaults to /ws/realtime on the page's own host (proxied by Vite).
# VITE_WS_URL=ws://localhost:8000/ws/realtime

# Optional. Map tiles; the default is OpenStreetMap's public server (development use only).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

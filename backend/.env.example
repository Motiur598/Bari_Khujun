# Copy to .env and fill in. MONGO_URI and both secrets are required; the server refuses to start without them.
MONGO_URI=mongodb://localhost:27017/propnexus

# Two different random secrets, at least 32 characters each. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_AUTH_SECRET=
QR_HANDSHAKE_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Exact frontend origins allowed to call the API (JSON list). "*" is rejected.
ALLOWED_ORIGINS=["http://localhost:5173"]

# Rate limiting. memory:// is per process; use redis://host:6379 when running several workers.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
# Largest request body accepted, in bytes (10 photos x 5 MB plus form data).
MAX_REQUEST_BODY_BYTES=57671680

# Set ENABLE_API_DOCS=false in production; set ENABLE_HSTS=true once the API is served over HTTPS.
ENABLE_API_DOCS=true
ENABLE_HSTS=false

# Frontend origin printed on lease PDFs (the verification QR stamp links here).
APP_BASE_URL=http://localhost:5173
QR_TOKEN_TTL_HOURS=24
# Minutes between checks for tenants whose move-out date has arrived.
MOVE_OUT_CHECK_MINUTES=15
# Minutes between scammer-radar sweeps (it also runs after every QR issue).
RADAR_CHECK_MINUTES=15
